<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="40dp"
    tools:context=".NewEventActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/editTextEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Event name"
            android:inputType="textShortMessage" />

        <TextView
            android:id="@+id/show_selected_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/editTextEventName"
            android:layout_marginTop="20dp"
            android:text="Start date"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pick_start_date_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/editTextEventName"
            android:layout_alignParentRight="true"
            android:layout_marginTop="10dp"
            android:text="Select start date"
            app:cornerRadius="100dp" />

        <TextView
            android:id="@+id/show_selected_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_start_date_button"
            android:text="Start time"
            android:layout_marginTop="10dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pick_start_time_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_start_date_button"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="10dp"
            android:text="Select start time"
            app:cornerRadius="100dp" />

        <TextView
            android:id="@+id/show_selected_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_start_time_button"
            android:layout_marginTop="20dp"
            android:text="End date"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pick_end_date_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_start_time_button"
            android:layout_alignParentRight="true"
            android:layout_marginTop="10dp"
            android:text="Select end date"
            app:cornerRadius="100dp" />

        <TextView
            android:id="@+id/show_selected_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_end_date_button"
            android:layout_marginTop="10dp"
            android:text="Start time"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pick_end_time_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_end_date_button"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="12dp"
            android:text="Select end time"
            app:cornerRadius="100dp" />

        <TextView
            android:id="@+id/show_selected_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_end_time_button"
            android:layout_marginTop="20dp"
            android:text="Address"
            android:textSize="18sp" />

        <Button
            android:id="@+id/address_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pick_end_time_button"
            android:layout_alignParentRight="true"
            android:layout_marginTop="10dp"
            android:text="Select an Address"
            app:cornerRadius="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCreateProject"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/address_button"
            android:layout_marginTop="40dp"
            android:text="Create Event"
            app:cornerRadius="100dp" />


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>