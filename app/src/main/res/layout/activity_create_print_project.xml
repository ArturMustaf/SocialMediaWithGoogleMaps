<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PrintProjectCreationActivity"
    android:paddingTop="40dp">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">


        <EditText
            android:id="@+id/editTextTextPrintProjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textShortMessage"
            android:hint="Project name"/>

        <EditText
            android:id="@+id/editTextTextPrintProjectDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textMultiLine"
            android:hint="Description (optional)"/>

        <EditText
            android:id="@+id/editTextTextSourceURL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textUri"
            android:hint="File source (optional)"/>

        <EditText
            android:id="@+id/editTextTextStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="date"
            android:hint="When your print starts"/>

        <EditText
            android:id="@+id/editTextTextDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number"
            android:hint="Print duration in hours"/>

        <Button
            android:id="@+id/buttonCreateProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Project" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>